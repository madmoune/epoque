{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomCode": {
        ".read": "auth != null && $roomCode.matches(/^[A-Z2-9]{6}$/)",
        ".write": "auth != null && $roomCode.matches(/^[A-Z2-9]{6}$/) && ((!data.exists() && newData.exists() && newData.child('id').val() === $roomCode && newData.child('hostId').val() === auth.uid && newData.child('players').child(auth.uid).child('id').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('hostId').val() === auth.uid) || (data.exists() && newData.exists() && data.child('players').child(auth.uid).exists()) || (data.exists() && newData.exists() && !data.child('players').child(auth.uid).exists() && newData.child('players').child(auth.uid).child('id').val() === auth.uid))",
        ".validate": "newData.hasChildren(['id', 'gameId', 'hostId', 'status', 'players', 'state']) && newData.child('id').val() === $roomCode && newData.child('gameId').isString() && newData.child('hostId').isString() && newData.child('status').isString()",
        "players": {
          "$playerId": {
            ".validate": "$playerId === newData.child('id').val() && newData.child('name').isString() && newData.child('name').val().length <= 32 && newData.child('online').isBoolean()"
          }
        }
      }
    },
    "puzzleCatalog": {
      ".read": "auth != null",
      "types": {
        "$typeId": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['id']) && newData.child('id').val() === $typeId",
          "id": {
            ".validate": "newData.isString() && newData.val() === $typeId"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
          },
          "state": {
            ".validate": "newData.isString() && newData.val().matches(/^(approved|pending|deleted)$/)"
          },
          "comment": {
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 1000)"
          },
          "families": {
            "$familyId": {
              ".write": "auth != null",
              ".validate": "newData.hasChildren(['id']) && newData.child('id').val() === $familyId",
              "id": {
                ".validate": "newData.isString() && newData.val() === $familyId"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
              },
              "state": {
                ".validate": "newData.isString() && newData.val().matches(/^(approved|pending|deleted)$/)"
              },
              "comment": {
                ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 1000)"
              }
            }
          },
          "variants": {
            "$variantId": {
              ".write": "auth != null",
              ".validate": "newData.hasChildren(['id']) && newData.child('id').val() === $variantId",
              "id": {
                ".validate": "newData.isString() && newData.val() === $variantId"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
              },
              "state": {
                ".validate": "newData.isString() && newData.val().matches(/^(approved|pending|deleted)$/)"
              },
              "comment": {
                ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 1000)"
              },
              "exampleCount": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
              }
            }
          }
        }
      }
    }
  }
}
